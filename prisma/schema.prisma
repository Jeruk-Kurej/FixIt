// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Karena kita pakai TiDB Cloud
  url      = env("DATABASE_URL")
}

// Tabel Pelanggan
model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  password      String?      // Menambahkan password untuk login
  phone         String?
  address       String?      // Alamat rumah untuk opsi Home Service
  age           Int?         // Umur pengguna
  gender        String?      // Jenis kelamin pengguna
  role          Role         @default(CUSTOMER)
  memberships   Membership[] // Relasi ke sistem langganan rutin
  appliances    Appliance[]  // Relasi ke barang elektronik yg didaftarkan
  orders        Order[]      // Relasi ke riwayat pesanan servis
  technician    Technician?  // Relasi jika user adalah teknisi
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// Tabel Katalog Kategori Barang (FixIt 2.0)
model ApplianceCategory {
  id             String       @id @default(uuid())
  name           String       // "AC", "Kulkas", dll
  iconUrl        String       // Lottie animation URL
  baseServiceFee Int          // Harga dasar inspeksi
  createdAt      DateTime     @default(now())
}

// Tabel Barang Elektronik (Milik Pelanggan)
model Appliance {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  type          String       // Menyimpan nama dari ApplianceCategory
  brand         String?      // Contoh: "Daikin", "Sharp"
  orders        Order[]
  createdAt     DateTime     @default(now())
}

// Tabel Membership (Untuk otomatisasi perawatan rutin)
model Membership {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  status        String       // "ACTIVE", "EXPIRED"
  startDate     DateTime     @default(now())
  endDate       DateTime
}

// Profil Teknisi (FixIt 2.0)
model Technician {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  trustScore    Float        @default(5.0)
  currentLat    Float?
  currentLng    Float?
  isAvailable   Boolean      @default(true)
  orders        Order[]      // Pesanan yang ditugaskan ke teknisi ini
}

// Tabel Order / Pesanan Servis
model Order {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  technicianId  String?
  technician    Technician?  @relation(fields: [technicianId], references: [id])
  applianceId   String
  appliance     Appliance    @relation(fields: [applianceId], references: [id])
  serviceType   String       // "HOME_SERVICE", "WORKSHOP_VISIT", "EXPRESS"
  status        String       // "PENDING", "ON_THE_WAY", "WORKING", "DONE"
  problem       String       // Keluhan (misal: "AC Kurang Dingin")
  estimatedCost Int?         // Transparansi harga awal dari kalkulator
  finalCost     Int?         // Harga riil setelah teknisi mengecek
  scheduledDate DateTime?    // Tanggal pemesanan untuk Smart Scheduling
  scheduledTime String?      // Waktu pemesanan (e.g., "10:00")
  createdAt     DateTime     @default(now())
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}