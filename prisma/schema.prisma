// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. Tabel: User (Pusat Autentikasi)
model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  phone      String
  address    String   @db.Text
  age        Int?
  gender     Gender?
  role       Role     @default(CUSTOMER)
  createdAt  DateTime @default(now())

  // Relationships
  appliances    Appliance[]
  orders        Order[]
  technician    Technician?
  notifications Notification[]
  memberships   Membership[]
}

model Membership {
  id              String   @id @default(uuid())
  user_id         String
  user            User     @relation(fields: [user_id], references: [id])
  appliance_name  String
  frequency_months Int
  status          MembershipStatus @default(PENDING)
  createdAt       DateTime @default(now())
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}




// 2. Tabel: Technician (Profil Profesional)
model Technician {
  id           String  @id @default(uuid())
  user_id      String  @unique
  user         User    @relation(fields: [user_id], references: [id])
  rating       Float   @default(5.0)
  is_available Boolean @default(true)

  // Relationships
  orders Order[]
}

// 3. Tabel: ApplianceType (Kategori Barang)
model ApplianceType {
  id                String        @id @default(uuid())
  name              String
  base_service_fee  Int
  
  // Relationships
  appliances   Appliance[]
  serviceTasks ServiceTask[]
}

// 4. Tabel: Appliance (Aset User)
model Appliance {
  id                String        @id @default(uuid())
  user_id           String
  user              User          @relation(fields: [user_id], references: [id])
  appliance_type_id String
  appliance_type    ApplianceType @relation(fields: [appliance_type_id], references: [id])
  brand             String
  model_number      String?

  // Relationships
  orders Order[]
}

// 5. Tabel: ServiceTask (Katalog Kerusakan)
model ServiceTask {
  id                String        @id @default(uuid())
  appliance_type_id String
  appliance_type    ApplianceType @relation(fields: [appliance_type_id], references: [id])
  task_name         String
  standard_price    Int
}

// 6. Tabel: Order (Transaksi & History)
model Order {
  id                  String      @id @default(uuid())
  user_id             String
  user                User        @relation(fields: [user_id], references: [id])
  technician_id       String?
  technician          Technician? @relation(fields: [technician_id], references: [id])
  appliance_id        String
  appliance           Appliance   @relation(fields: [appliance_id], references: [id])
  status              OrderStatus @default(PENDING)
  payment_status      PaymentStatus @default(UNPAID)
  problem             String      @db.Text
  scheduled_date_time DateTime
  service_type        ServiceType @default(HOME_SERVICE)
  estimated_cost      Int
  final_cost          Int?

  technical_findings Json?
  technical_notes    String?     @db.Text

  createdAt           DateTime    @default(now())

  // Relationships
  order_details OrderDetail[]
  messages Message[]
  payments Payment[]
}

// 7. Tabel: OrderDetail (Rincian Pekerjaan)
model OrderDetail {
  id           String  @id @default(uuid())
  order_id     String
  order        Order   @relation(fields: [order_id], references: [id])
  task_name    String
  price        Int
  is_confirmed Boolean @default(false)
}

// 8. Tabel: Payment (Escrow System)
model Payment {
  id            String      @id @default(uuid())
  order_id      String
  order         Order       @relation(fields: [order_id], references: [id])
  amount        Int
  proof_url     String?     @db.Text
  type          PaymentType
  status        PaymentVerificationStatus @default(PENDING)
  admin_notes   String?     @db.Text
  verifiedAt    DateTime?
  createdAt     DateTime    @default(now())
}

// 9. Tabel: ChatMessage (Komunikasi Pelanggan & Teknisi)
model Message {
  id        String   @id @default(uuid())
  order_id  String
  order     Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  sender_id String
  content   String   @db.Text
  createdAt DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  WORKING
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DP_PAID
  FULLY_PAID
}

enum PaymentType {
  DOWN_PAYMENT
  FINAL_BALANCE
  FULL_PAYMENT
}

enum PaymentVerificationStatus {
  PENDING
  VALID
  INVALID
}

enum ServiceType {
  HOME_SERVICE
  WORKSHOP_VISIT
}

model Notification {
  id        String   @id @default(cuid())
  user_id   String
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, REMINDER, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}


