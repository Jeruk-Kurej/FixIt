generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  address       String?        @db.Text
  age           Int?
  gender        Gender?
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  appliances    Appliance[]
  memberships   Membership[]
  notifications Notification[]
  orders        Order[]
  reviews       Review[]
  technician    Technician?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id               String           @id @default(uuid())
  user_id          String
  appliance_name   String
  frequency_months Int
  status           MembershipStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "Membership_user_id_fkey")
}

model Technician {
  id           String          @id @default(uuid())
  user_id      String          @unique
  rating       Float           @default(5)
  is_available Boolean         @default(true)
  bank_name    String?
  bank_account String?
  bank_owner   String?
  orders       Order[]
  reviews      Review[]
  user         User            @relation(fields: [user_id], references: [id])
  specialties  ApplianceType[]
}

model ApplianceType {
  id               String        @id @default(uuid())
  name             String
  base_service_fee Int
  appliances       Appliance[]
  serviceTasks     ServiceTask[]
  technicians      Technician[]
}

model Appliance {
  id                String        @id @default(uuid())
  user_id           String
  appliance_type_id String
  name              String?
  brand             String
  model_number      String?
  appliance_type    ApplianceType @relation(fields: [appliance_type_id], references: [id])
  user              User          @relation(fields: [user_id], references: [id])
  orders            Order[]

  @@index([appliance_type_id], map: "Appliance_appliance_type_id_fkey")
  @@index([user_id], map: "Appliance_user_id_fkey")
}

model ServiceTask {
  id                String        @id @default(uuid())
  appliance_type_id String
  task_name         String
  standard_price    Int
  appliance_type    ApplianceType @relation(fields: [appliance_type_id], references: [id])

  @@index([appliance_type_id], map: "ServiceTask_appliance_type_id_fkey")
}

model Order {
  id                  String        @id @default(uuid())
  user_id             String
  technician_id       String?
  appliance_id        String
  status              OrderStatus   @default(PENDING)
  problem             String        @db.Text
  scheduled_date_time DateTime
  estimated_cost      Int
  final_cost          Int?
  createdAt           DateTime      @default(now())
  service_type        ServiceType   @default(HOME_SERVICE)
  technical_findings  Json?
  technical_notes     String?       @db.Text
  payment_status      PaymentStatus @default(UNPAID)
  messages            Message[]
  appliance           Appliance     @relation(fields: [appliance_id], references: [id])
  technician          Technician?   @relation(fields: [technician_id], references: [id])
  user                User          @relation(fields: [user_id], references: [id])
  order_details       OrderDetail[]
  payments            Payment[]
  review              Review?

  @@index([appliance_id], map: "Order_appliance_id_fkey")
  @@index([technician_id], map: "Order_technician_id_fkey")
  @@index([user_id], map: "Order_user_id_fkey")
}

model Review {
  id            String     @id @default(uuid())
  order_id      String     @unique
  technician_id String
  user_id       String
  rating        Int        @default(5)
  comment       String?    @db.Text
  createdAt     DateTime   @default(now())
  order         Order      @relation(fields: [order_id], references: [id])
  technician    Technician @relation(fields: [technician_id], references: [id])
  user          User       @relation(fields: [user_id], references: [id])

  @@index([technician_id])
  @@index([user_id])
}

model OrderDetail {
  id           String  @id @default(uuid())
  order_id     String
  task_name    String
  price        Int
  is_confirmed Boolean @default(false)
  order        Order   @relation(fields: [order_id], references: [id])

  @@index([order_id], map: "OrderDetail_order_id_fkey")
}

model Payment {
  id          String                    @id @default(uuid())
  order_id    String
  amount      Int
  proof_url   String?                   @db.Text
  type        PaymentType
  method      String?                   @db.VarChar(20)
  status      PaymentVerificationStatus @default(PENDING)
  midtrans_id String?                   @db.VarChar(255)
  admin_notes String?                   @db.Text
  verifiedAt  DateTime?
  createdAt   DateTime                  @default(now())
  order       Order                     @relation(fields: [order_id], references: [id])

  @@index([order_id], map: "Payment_order_id_fkey")
}

model Message {
  id        String   @id @default(uuid())
  order_id  String
  sender_id String
  content   String   @db.Text
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
  order     Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id], map: "Message_order_id_fkey")
}

model Notification {
  id           String   @id @default(cuid())
  title        String
  message      String
  type         String   @default("INFO")
  isRead       Boolean  @default(false)
  isToastShown Boolean  @default(false)
  createdAt    DateTime @default(now())
  user_id      String
  link         String?
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "Notification_user_id_fkey")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  WORKING
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DP_PAID
  FULLY_PAID
}

enum PaymentType {
  DOWN_PAYMENT
  FINAL_BALANCE
  FULL_PAYMENT
}

enum PaymentVerificationStatus {
  PENDING
  VALID
  INVALID
}

enum ServiceType {
  HOME_SERVICE
  WORKSHOP_VISIT
}
