// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tabel User
model User {
  id         String       @id @default(uuid())
  name       String
  email      String       @unique
  password   String
  phone      String
  address    String       @db.Text
  role       Role         @default(CUSTOMER)
  createdAt  DateTime     @default(now())
  appliances Appliance[]
  orders     Order[]
  technician Technician?
}

// Tabel Technician
model Technician {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id])
  trustScore  Float       @default(5.0)
  isAvailable Boolean     @default(true)
  orders      Order[]
}

// Tabel ApplianceType
model ApplianceType {
  id             String        @id @default(uuid())
  name           String
  baseServiceFee Int
  iconUrl        String
  appliances     Appliance[]
  serviceTasks   ServiceTask[]
}

// Tabel Appliance
model Appliance {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  applianceTypeId String
  applianceType   ApplianceType @relation(fields: [applianceTypeId], references: [id])
  brand           String
  modelNumber     String
  orders          Order[]
}

// Tabel ServiceTask
model ServiceTask {
  id              String        @id @default(uuid())
  applianceTypeId String
  applianceType   ApplianceType @relation(fields: [applianceTypeId], references: [id])
  taskName        String
  standardPrice   Int
}

// Tabel Order
model Order {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  technicianId       String?
  technician         Technician?   @relation(fields: [technicianId], references: [id])
  applianceId        String
  appliance          Appliance     @relation(fields: [applianceId], references: [id])
  status             OrderStatus   @default(PENDING)
  problemDescription String        @db.Text
  estimatedCost      Int
  finalCost          Int?
  scheduledDateTime  DateTime
  createdAt          DateTime      @default(now())
  orderDetails       OrderDetail[]
}

// Tabel OrderDetail
model OrderDetail {
  id                String  @id @default(uuid())
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id])
  taskName          String
  price             Int
  isConfirmedByTech Boolean @default(false)
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  WORKING
  DONE
  CANCELLED
}